    +SEA_DEPTH_1: any
    +SEA_DEPTH_2: any
    +SEA_DEPTH_3: any
    +SEA_DEPTH_4: any
    +FLOAT_WHITE: any
    -thresholds: number[]
    -blurredInputImage: any
    -blurredInputImageFloat: any
    +apply(image: any): any
    +drawWithNewSeeds(): any
    -createOutputImage(): any
    -applyThresholds(image: any): any
    -calculateSeaDepth(): any
}
class VintageStyle extends ImageStyle {
    +AGING_STRENGTH_0: any
    +AGING_STRENGTH_1: any
