    +AGING_STRENGTH_3: any
    +AGING_STRENGTH_4: any
    +thresholds: number[]
    +apply(image: any): any
    +drawWithNewSeeds(): any
    +applyThresholds(image: any): any
}
class ImageStyleManager {
    -binaryStyle: BinaryStyle
    -vintageStyle: VintageStyle
    -classicStyle: ClassicStyle
    -activeStyle: ImageStyle
    -inputImage: any
    +apply(): any
    +setActive(style: ImageStyleEnum): void
    +setInputImage(image: any): void
    +setSeedAndGetImage(seed: number): any
    -getStyle(style: ImageStyleEnum): ImageStyle
}
class ImageDownloader extends AbstractEditor {
    #imageStyleSelected: ImageStyleEnum
    -styleManager: ImageStyleManager
    +editorExpanded: any
